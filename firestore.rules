rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validMovie(data) {
      return data.keys().hasOnly(['title', 'kind', 'year', 'runtimeMinutes', 'weight', 'status', 'createdAt', 'addedBy', 'addedByName', 'genre', 'streamingService'])
        && data.keys().hasAll(['title', 'year', 'weight', 'status', 'createdAt', 'addedBy'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.get('kind', 'movie') in ['movie', 'series']
        && (data.year == null || (data.year is int && data.year >= 1888 && data.year <= 2100))
        && (data.get('runtimeMinutes', null) == null || (data.runtimeMinutes is int && data.runtimeMinutes >= 1 && data.runtimeMinutes <= 1440))
        && (data.get('kind', 'movie') != 'series' || data.get('runtimeMinutes', null) == null)
        && data.weight is int && data.weight >= 1 && data.weight <= 10
        && data.status in ['backlog', 'watched']
        && data.createdAt is int
        && data.addedBy is string
        && (data.get('addedByName', null) == null || (data.addedByName is string && data.addedByName.size() > 0 && data.addedByName.size() <= 100))
        && (data.get('genre', null) == null || data.genre in [
          'Action', 'Adventure', 'Animation', 'Biography', 'Comedy', 'Crime',
          'Documentary', 'Drama', 'Family', 'Fantasy', 'History', 'Horror',
          'Music', 'Musical', 'Mystery', 'Romance', 'Science Fiction', 'Sport',
          'Thriller', 'War', 'Western', 'Other'
        ])
        && (data.get('streamingService', null) == null || data.streamingService in [
          'Netflix', 'Amazon Prime Video', 'Disney+'
        ]);
    }

    match /members/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isMember());
      allow list, create, update, delete: if false;
    }

    match /movies/{movieId} {
      allow read: if isMember();
      allow create: if isMember()
        && validMovie(request.resource.data)
        && request.resource.data.keys().hasAll(['addedByName', 'genre', 'streamingService', 'kind', 'runtimeMinutes'])
        && request.resource.data.addedByName is string
        && request.resource.data.genre is string
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if isMember()
        && validMovie(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.get('addedByName', null) == resource.data.get('addedByName', null)
        && (!resource.data.keys().hasAny(['genre']) || request.resource.data.keys().hasAny(['genre']))
        && (!resource.data.keys().hasAny(['streamingService']) || request.resource.data.keys().hasAny(['streamingService']))
        && (!resource.data.keys().hasAny(['kind']) || request.resource.data.keys().hasAny(['kind']))
        && (!resource.data.keys().hasAny(['runtimeMinutes']) || request.resource.data.keys().hasAny(['runtimeMinutes']));
      allow delete: if isMember();
    }
  }
}
